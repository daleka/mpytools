{
  "name": "mpytools",
  "displayName": "MPyTools",
  "description": "MPyTools – просте та гнучке розширення для роботи з MicroPython у VS Code. | MPyTools – a simple and flexible extension for working with MicroPython in VS Code.",
  "version": "0.4.8",
  "preview": true,
  "publisher": "daleka",
  "repository": {
    "type": "git",
    "url": "https://github.com/daleka/mpytools.git"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mpytools.connect",
        "title": "MPY: Connect and start REPL / Підключитись та запустити REPL"
      },
      {
        "command": "mpytools.selectPort",
        "title": "MPY: Select Port / Обрати порт"
      },
      {
        "command": "mpytools.compileAndRun",
        "title": "MPY: Compile and Run / Компілювати та запустити"
      },
      {
        "command": "mpytools.installDependencies",
        "title": "MPY: Install Managed Toolchain / Встановити ізольовані інструменти"
      },
      {
        "command": "mpytools.installStubs",
        "title": "MPY: Install Workspace Stubs / Встановити stubs"
      },
      {
        "command": "mpytools.diagnostics",
        "title": "MPY: Diagnostics / Діагностика"
      },
      {
        "command": "mpytools.saveProject",
        "title": "MPY: Save Project Archive / Архівувати проєкт"
      },
      {
        "command": "mpytools.runActive",
        "title": "MPY: Run Active File / Запустити активний файл"
      },
      {
        "command": "mpytools.stop",
        "title": "MPY: Stop / Зупинити"
      },
      {
        "command": "mpytools.repl",
        "title": "MPY: Open REPL"
      },
      {
        "command": "mpytools.resetHard",
        "title": "MPY: Hard Reset"
      },
      {
        "command": "mpytools.openSettings",
        "title": "MPY: Settings / Налаштування"
      },
      {
        "command": "mpytools.selectBuildOutputLocation",
        "title": "MPY: Select Build Folder Location / Обрати розташування папки збірки"
      },
      {
        "command": "mpytools.openBuildOutput",
        "title": "MPY: Open Build Folder / Відкрити папку збірки"
      },
      {
        "command": "mpytools.clearBuildCache",
        "title": "MPY: Clear Build Cache / Очистити кеш збірки"
      },
      {
        "command": "mpytoolsFileExplorer.refreshFolder",
        "title": "Refresh folder / Оновити папку"
      },
      {
        "command": "mpytoolsFileExplorer.refreshDevice",
        "title": "♻️Refresh device / Оновити пристрій"
      },
      {
        "command": "mpytoolsFileExplorer.createDeviceFile",
        "title": "Create File / Створити файл"
      },
      {
        "command": "mpytoolsFileExplorer.createDeviceFolder",
        "title": "Create Folder / Створити папку"
      },
      {
        "command": "mpytoolsFileExplorer.deleteDeviceFolder",
        "title": "Delete Device Folder / Видалити папку"
      },
      {
        "command": "mpytoolsFileExplorer.renameDeviceFile",
        "title": "Rename Device File / Перейменувати файл"
      },
      {
        "command": "mpytoolsFileExplorer.deleteDeviceFile",
        "title": "Delete Device File / Видалити файл"
      },
      {
        "command": "mpytoolsFileExplorer.sendDeviceFileToLocal",
        "title": "Send Device File to Local / Відправити файл в локальний проєкт"
      },
      {
        "command": "mpytoolsFileExplorer.measureDeviceSpace",
        "title": "🔢Measure Space / Заміряти пам’ять"
      },
      {
        "command": "mpytoolsFileExplorer.clearDevice",
        "title": "🧹Clear Device / Очистити пристрій"
      }
    ],
    "configuration": {
      "title": "MPyTools",
      "properties": {
        "mpytools.mpremotePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to an mpremote executable. This explicit override takes priority over managed and PATH installations."
        },
        "mpytools.wrappableAssetExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.?[A-Za-z0-9_-]+$"
          },
          "default": [
            ".cfg",
            ".css",
            ".csv",
            ".htm",
            ".html",
            ".ini",
            ".js",
            ".json",
            ".md",
            ".svg",
            ".toml",
            ".txt",
            ".xml",
            ".yaml",
            ".yml"
          ],
          "scope": "resource",
          "description": "File extensions that MPyTools may wrap into importable Python modules when non-.py compilation is enabled. Other assets are copied unchanged. Generated Python caches are always ignored."
        },
        "mpytools.buildOutputLocation": {
          "type": "string",
          "enum": [
            "extensionStorage",
            "workspace"
          ],
          "enumDescriptions": [
            "Keep generated files in protected VS Code extension storage. Use MPY: Open Build Folder to inspect them.",
            "Use a visible <project>/mpy folder owned and pruned by MPyTools."
          ],
          "default": "extensionStorage",
          "scope": "resource",
          "description": "Where MPyTools stores the generated folder uploaded to the device. Workspace mode restores the visible mpy/ workflow; extension storage reduces VS Code file watching."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mpytoolsFileManagerContainer",
          "title": "MPyTools",
          "icon": "icon2.svg"
        }
      ]
    },
    "views": {
      "mpytoolsFileManagerContainer": [
        {
          "id": "mpytoolsFileExplorer",
          "name": "Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [],
      "view/item/context": [
        {
          "command": "mpytoolsFileExplorer.refreshFolder",
          "when": "viewItem == device-folder",
          "group": "navigation"
        },
        {
          "command": "mpytoolsFileExplorer.refreshDevice",
          "when": "viewItem == device-root",
          "group": "navigation"
        },
        {
          "command": "mpytoolsFileExplorer.createDeviceFile",
          "when": "viewItem == device-folder",
          "group": "2_files"
        },
        {
          "command": "mpytoolsFileExplorer.createDeviceFolder",
          "when": "viewItem == device-folder",
          "group": "3_folders"
        },
        {
          "command": "mpytoolsFileExplorer.deleteDeviceFolder",
          "when": "viewItem == device-folder",
          "group": "5_delete"
        },
        {
          "command": "mpytoolsFileExplorer.renameDeviceFile",
          "when": "viewItem == device-file",
          "group": "3_rename"
        },
        {
          "command": "mpytoolsFileExplorer.deleteDeviceFile",
          "when": "viewItem == device-file",
          "group": "4_delete"
        },
        {
          "command": "mpytoolsFileExplorer.sendDeviceFileToLocal",
          "when": "viewItem == device-file",
          "group": "5_send"
        },
        {
          "command": "mpytoolsFileExplorer.measureDeviceSpace",
          "when": "viewItem == device-root",
          "group": "device_actions"
        },
        {
          "command": "mpytoolsFileExplorer.clearDevice",
          "when": "viewItem == device-root",
          "group": "device_actions"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "mocha --ui tdd \"out/test/core.test.js\"",
    "test:integration": "vscode-test",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm test && npm run check:release && npm audit --omit=dev",
    "package:vsix": "npm run check && vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "1.97.0",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.19.0",
    "mocha": "^11.7.5",
    "typescript": "^5.7.3"
  },
  "icon": "icon.png",
  "keywords": [
    "MicroPython",
    "mpremote",
    "mpy",
    "mpy-cross",
    "ESP32",
    "RP2040",
    "STM32",
    "Pico",
    "PyBoard",
    "Python",
    "Embedded",
    "IoT",
    "VSCode"
  ],
  "dependencies": {
    "yazl": "^3.3.1"
  }
}
